# OS
.DS_Store

# Environment
.env
.env.*
!.env.example

# Python
__pycache__/

# Scratch
.scratch/

# Dependencies
node_modules/

# Fluent — working state, except project config, expertise, hooks, Dockerfile,
# and tester contract files. Observations stay local, not committed.
.fluent/*
!.fluent/config.yaml
!.fluent/expertise/
!.fluent/hooks/
!.fluent/Dockerfile
!.fluent/tester.yaml
!.fluent/release-host.yaml
!.fluent/extract-tester-results


# Test output (per-case logs, never committed)
tests/output/

# Added by cargo
/target
/.cargo-home
/.cargo
.cargo-home/
cargo-home/
.cargo-cache/
